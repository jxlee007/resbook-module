<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_resource_booking_form" model="ir.ui.view">
        <field name="name">resource.booking.form</field>
        <field name="model">resource.booking</field>
        <field name="arch" type="xml">
            <form string="Resource Booking">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Conference Room A"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree (List) View -->
    <record id="view_resource_booking_tree" model="ir.ui.view">
        <field name="name">resource.booking.tree</field>
        <field name="model">resource.booking</field>
        <field name="arch" type="xml">
            <list string="Resource Bookings">
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_resource_booking_kanban" model="ir.ui.view">
        <field name="name">resource.booking.kanban</field>
        <field name="model">resource.booking</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <!-- 🏷️ Booking Name -->
                                <strong>
                                    <field name="name"/>
                                </strong>
                                <div>
                                    <!-- 👤 Customer -->
                                    <field name="customer_id"/>
                                </div>
                                <div>
                                    <!-- ⏰ Slot Timing -->
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_resource_booking" model="ir.actions.act_window">
        <field name="name">Resource Bookings</field>
        <field name="res_model">resource.booking</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first resource booking!
            </p>
        </field>
    </record>

    <!-- Root Menu with Action Assigned -->
    <menuitem id="menu_resource_booking_root" name="Resource Booking" action="action_resource_booking" sequence="10"/>

    <!-- Sub Menu Items -->
    <menuitem id="menu_resource_booking_item" name="Bookings" parent="menu_resource_booking_root" action="action_resource_booking" sequence="10"/>
</odoo>