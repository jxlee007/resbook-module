<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Resource Booking Form View -->
    <record id="view_resource_booking_form" model="ir.ui.view">
        <field name="name">resource.booking.form</field>
        <field name="model">resource.booking</field>
        <field name="arch" type="xml">
            <form string="Resource Booking">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Conference Room A"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Booking Details">
                            <field name="customer_id"/>
                            <field name="slot_id"/>
                        </group>
                        <group string="Slot Timing">
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <group string="Additional Information">
                        <field name="description" placeholder="Add booking description or notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Resource Booking List (Tree) View -->
    <record id="view_resource_booking_tree" model="ir.ui.view">
        <field name="name">resource.booking.tree</field>
        <field name="model">resource.booking</field>
        <field name="arch" type="xml">
            <list string="Resource Bookings">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="slot_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'" decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Resource Booking Kanban View -->
    <record id="view_resource_booking_kanban" model="ir.ui.view">
        <field name="name">resource.booking.kanban</field>
        <field name="model">resource.booking</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="slot_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong>
                                    <field name="name"/>
                                </strong>
                                <div>
                                    <span>Customer: </span>
                                    <field name="customer_id"/>
                                </div>
                                <div>
                                    <span>Slot: </span>
                                    <field name="slot_id"/>
                                </div>
                                <div>
                                    <span>Timing: </span>
                                    <field name="start_date"/> - <field name="end_date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Resource Booking Action Window -->
    <record id="action_resource_booking" model="ir.actions.act_window">
        <field name="name">Resource Bookings</field>
        <field name="res_model">resource.booking</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first resource booking!
            </p>
        </field>
    </record>

    <!-- Resource Booking Slot List (Tree) View -->
    <record id="view_resource_booking_slot_tree" model="ir.ui.view">
        <field name="name">resource.booking.slot.tree</field>
        <field name="model">resource.booking.slot</field>
        <field name="arch" type="xml">
            <list string="Booking Slots">
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="state" widget="badge" decoration-success="state == 'available'" decoration-danger="state == 'booked'"/>
            </list>
        </field>
    </record>

    <!-- Resource Booking Slot Form View -->
    <record id="view_resource_booking_slot_form" model="ir.ui.view">
        <field name="name">resource.booking.slot.form</field>
        <field name="model">resource.booking.slot</field>
        <field name="arch" type="xml">
            <form string="Booking Slot">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="available,booked"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Resource Booking Slot Action Window -->
    <record id="action_resource_booking_slot" model="ir.actions.act_window">
        <field name="name">Booking Slots</field>
        <field name="res_model">resource.booking.slot</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first booking slot!
            </p>
        </field>
    </record>

    <!-- Root Menu Item -->
    <menuitem id="menu_resource_booking_root" name="Resource Booking" sequence="10"/>

    <!-- Sub Menu Items -->
    <menuitem id="menu_resource_booking_item" name="Bookings" parent="menu_resource_booking_root" action="action_resource_booking" sequence="10"/>
    <menuitem id="menu_resource_booking_slot_item" name="Booking Slots" parent="menu_resource_booking_root" action="action_resource_booking_slot" sequence="20"/>
</odoo>